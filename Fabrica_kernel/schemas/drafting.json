{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "schema-drafting-mission",
  "type": "drafting",
  "title": "Drafting & Discovery Phase Schema",
  "description": "Governs requirement gathering, Q&A briefs, domain research, and problem framing.",
  "protected": true,
  "version": "3.0.0",
  "phase": "drafting",
  "phase_selection": "single",
  "storage_paths": {
    "scratchpad": "missions/{missionId}/drafting/",
    "sources": "workspace/Sources/Discovery & Scoping/",
    "deliverables": "workspace/Deliverables/Reviews/",
    "state_index": "missions.json",
    "workspace_index": "workspace.json",
    "event_stream": "logs.json"
  },
  "sub_stages": [
    {
      "id": "discovery",
      "title": "Discovery & Scoping",
      "description": "Interactive Q&A briefs, requirements gathering, and cost/time trade-off options.",
      "output_path": "workspace/Sources/Discovery & Scoping/"
    },
    {
      "id": "deep_research",
      "title": "Deep Research & Intelligence Gathering",
      "description": "Scraped docs, research papers, competitor scans, and API references.",
      "output_path": "workspace/Sources/Deep Research & Intelligence Gathering/"
    }
  ],
  "pipeline": {
    "stages": ["discovery", "deep_research"],
    "required_inputs": ["raw_prompt", "domain_context"],
    "outputs": ["scoping_document", "requirements_brief"]
  },
  "rules": {
    "require_qa": true,
    "transaction_safe": true,
    "memory_retention": "persistent"
  }
}
