{
  "name": "fabrica-saas",
  "version": "1.0.0",
  "description": "Fabrica SaaS - AI Business Systems Dashboard & Sync Daemon",
  "main": "server.ts",
  "type": "module",
  "workspaces": [
    "frontend-next"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build:frontend": "npm run build --prefix frontend-next",
    "build": "npm run build:frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/discoveryengine": "^2.8.0",
    "@google-cloud/storage": "^7.21.0",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@supabase/supabase-js": "^2.110.7",
    "cheerio": "^1.2.0",
    "d3": "^7.9.0",
    "express": "^4.19.2",
    "firebase": "^12.16.0",
    "ws": "^8.21.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.21.5",
    "tsx": "^4.15.6",
    "typescript": "^7.0.2"
  }
}
